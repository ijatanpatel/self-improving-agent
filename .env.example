# Copy this file to .env and fill it in. .env is gitignored: never commit it.
OPENAI_API_KEY=

# Models (any model your key can use)
BOT_MODEL=gpt-4.1-mini          # the support bot
EMBED_MODEL=text-embedding-3-small
JUDGE_MODEL=gpt-5-mini          # the online evaluator's LLM judge
AGENT_MODEL=gpt-5.5             # the investigation and fix agents
AGENT_EFFORT=medium

# Local Arize Phoenix (start it with: uv run phoenix serve)
PHOENIX_URL=http://localhost:6006
PHOENIX_PROJECT=support-bot

# Pull requests. Leave GITHUB_REPO empty to keep fix branches local.
GITHUB_REPO=                    # e.g. your-user/self-improving-agent
GITHUB_ACCOUNT=                 # which logged-in gh account should open the PRs
BASE_BRANCH=main

DEEPEVAL_TELEMETRY_OPT_OUT=YES
